<?xml version="1.0" encoding="utf-8"?>
<!-- A · 2x1 wear timer: status, live total for today, Put in / Take out button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wear_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Not wearing"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />

        <Chronometer
            android:id="@+id/wear_chrono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="@color/widget_text"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/wear_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="0h 0m"
            android:textColor="@color/widget_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wear_limit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/wear_button"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:background="@drawable/widget_button_accent"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="Put in"
        android:textColor="@color/widget_button_accent_text"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
